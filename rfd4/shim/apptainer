#!/usr/bin/env python3
"""
Fake `apptainer`, so RFD4's AF3 "oracle" (reward-guided search) runs on a native AlphaFold 3 install without a container.

RFD4 starts its AF3 worker as:  apptainer run [--nv] [--env K=V ...] [--bind A:B ...] IMAGE python run_alphafold_batch.py FLAGS...
This script ignores the container options and the image, applies the --env values, and runs the same script with the python of the
conda env that has AF3 (AF3_ENV_PYTHON, set by ./setup.sh; default ~/miniconda3/envs/af3/bin/python) through patched_worker.py,
which drops the one argument only RFD4's patched AF3 build understands. Stock AF3 only: OpenFold3 weights are refused.
"""
import os
import sys

a = sys.argv[1:]
assert a and a[0] == "run", f"only `apptainer run` is emulated, got: {a[:3]}"
env = dict(os.environ)
i = 1
while i < len(a):
    if a[i] == "--env":
        k, v = a[i + 1].split("=", 1)
        env[k] = v
        i += 2
    elif a[i] == "--bind":
        i += 2
    elif a[i] == "--nv":
        i += 1
    else:
        break
i += 1                                               # skip the image
assert a[i] == "python", f"expected `python` after the image, got {a[i]!r}"
py = env.get("AF3_ENV_PYTHON") or os.path.expanduser("~/miniconda3/envs/af3/bin/python")
worker = os.path.join(os.path.dirname(os.path.abspath(__file__)), "patched_worker.py")
os.execve(py, [py, worker] + a[i + 1:], env)
